<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath Condition="'$(OrbitBuildRoot)' != ''">$(OrbitBuildRoot)\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(OrbitBuildRoot)' != ''">$(OrbitBuildRoot)\$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
